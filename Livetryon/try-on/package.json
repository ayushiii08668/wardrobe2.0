{
  "name": "tryon-anywear",
  "displayName": "Try-On Anywear",
  "version": "0.1.0",
  "description": "Virtual try-on room for any shopping site, powered by your own Decart key",
  "author": "you",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"const fs = require('fs'); ['node_modules/zod/package.json', 'node_modules/.pnpm/zod@4.6.7/node_modules/zod/package.json'].forEach(p => { if (fs.existsSync(p)) { const pkg = JSON.parse(fs.readFileSync(p, 'utf8')); pkg.module = './index.cjs'; fs.writeFileSync(p, JSON.stringify(pkg, null, 2)); } });\""
  },
  "dependencies": {
    "@decartai/sdk": "^0.2.14",
    "@plasmohq/storage": "^1.5.0",
    "framer-motion": "^12.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.280",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.0.0",
    "plasmo": "^0.90.5",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  },
  "manifest": {
    "permissions": [
      "storage",
      "contextMenus",
      "sidePanel"
    ],
    "host_permissions": [
      "https://*/*",
      "http://localhost/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/room.html"
        ],
        "matches": [
          "https://*/*",
          "http://localhost:*/*",
          "http://127.0.0.1:*/*"
        ]
      }
    ]
  }
}
