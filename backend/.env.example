PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/wardrobewise
CLIENT_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ── Groq AI (FREE — Get key at https://console.groq.com) ──────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Google Gemini Multimodal AI (Cloud 2D-to-3D Garment Generation) ──────────
# Get your Gemini API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenCV Python AI Service (Optional fallback) ──────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=10000
AI_MOCK_FALLBACK=true
AI_RECOMMENDATION_SERVICE_URL=http://127.0.0.1:8000
AI_RECOMMENDATION_TIMEOUT_MS=10000
AI_RECOMMENDATION_MOCK_FALLBACK=true

# ── Tripo3D API (Optional fallback) ──────────────────────────────────────────
TRIPO_API_KEY=
TRIPO_API_BASE_URL=https://openapi.tripo3d.com/v3

# ── Hugging Face Token (FREE — For IDM-VTON Photorealistic Diffusion Virtual Try-On) ──
# Get your free token at https://huggingface.co/settings/tokens
HF_TOKEN=

